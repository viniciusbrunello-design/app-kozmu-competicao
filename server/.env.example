# Copie este arquivo para .env e preencha os valores reais
# NÃO suba o arquivo .env para o GitHub

# Banco de dados (Supabase > Project Settings > Database > URI — use a Transaction pooler URI)
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres"

# JWT — gere valores aleatórios (ex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="troque-por-um-segredo-aleatorio-longo"
JWT_REFRESH_SECRET="troque-por-outro-segredo-aleatorio-longo"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Porta local (Railway injeta a PORT automaticamente em produção)
PORT=3001

# Ambiente
NODE_ENV=production

# URL do frontend no Vercel (sem barra no final)
CORS_ORIGIN="https://seu-projeto.vercel.app"
